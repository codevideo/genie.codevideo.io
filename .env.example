# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<clerk-publishable-key>
CLERK_SECRET_KEY=<clerk-secret-key>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Stripe (for Go functions)
STRIPE_SECRET_KEY=<stripe-secret-key>

# Slack notifications (optional)
SLACK_WEBHOOK_URL=<slack-webhook-url>

# Genie generation backend (codevideo-genie). Local dev: backend HTTP on 3001
# (NOT 3000 — that collides with next/netlify dev), WS on 9000.
NEXT_PUBLIC_GENIE_API_URL=http://localhost:3001
NEXT_PUBLIC_GENIE_WS_URL=ws://localhost:3001
